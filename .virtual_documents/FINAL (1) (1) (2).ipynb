        if "choices" in data:
            answer = data["choices"][0]["message"]["content"].strip()
            answer = answer.replace("\n", " ")[:300]
            answers.append({
                "question": question,
                "answer": answer
            })
            print(f"➡️ Answer {idx}: {answer}\n")
        else:
            print(f"⚠️ LLaMA response missing 'choices' for Prompt {idx}")
            print(f"Returned: {data}")
    except Exception as e:
        print(f"❌ Error generating answer for Prompt {idx}: {e}")



